# Скопируйте в .env и при необходимости измените. Значения по умолчанию подходят для локального запуска.
APP_ENV=dev
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
SITE_URL=http://localhost:8080
POSTGRES_DB=gdevolna
POSTGRES_USER=gdevolna
POSTGRES_PASSWORD=gdevolna
RABBITMQ_USER=gdevolna
RABBITMQ_PASSWORD=gdevolna
MINIO_ROOT_USER=gdevolna
MINIO_ROOT_PASSWORD=gdevolna-secret
S3_BUCKET=gdevolna-media
# 1 — загрузить посевные данные из прототипа при первом старте (только dev/staging)
SEED_DEMO=1
